{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/workspace-asset.js": { "includeFiles": "{calculator.html,workspace-private/app.js,workspace-private/scaffold-app.js}" }
  },
  "rewrites": [
    { "source": "/calculator.html", "destination": "/api/workspace-asset?asset=calculator" },
    { "source": "/app.js", "destination": "/api/workspace-asset?asset=app" },
    { "source": "/scaffold-app.js", "destination": "/api/workspace-asset?asset=scaffold-app" }
  ]
}
